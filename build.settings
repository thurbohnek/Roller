-- Supported values for orientation:
-- portrait, portraitUpsideDown, landscapeLeft, landscapeRight

settings = {

	build = {
		neverStripDebugInfo = true, -- keep file/line info in error tracebacks
	},

	-- opprinnelig-fra-dropbox/ er referansefiler for Ørjan, ikke noe spillet
	-- bruker. projectPath i Util/recipe-html5.lua peker på hele repo-roten,
	-- så uten dette ville de ~28 MB blitt kopiert rått inn i HTML5-bundelen
	-- som "assets". Stjernen etter mappenavnet er det som ekskluderer hele
	-- mappen (uten den ville den bare blitt inkludert som en tom mappe).
	excludeFiles = {
		-- Util/ er verktøy (Python, tegninger), *.md er dokumentasjon. Ingen
		-- av delene brukes av spillet.
		all = { "opprinnelig-fra-dropbox*", "Util*", "*.md", "*.py" },
	},

	orientation = {
		default = "landscapeRight",
		supported = { "landscapeRight", "landscapeLeft"}
	},
	
	iphone = {
		plist = {
			UIStatusBarHidden = false,
			UIPrerenderedIcon = true, -- set to false for "shine" overlay
			--UIApplicationExitsOnSuspend = true, -- uncomment to quit app on suspend

            --[[
            -- iOS app URL schemes:
            CFBundleURLTypes =
            {
                {
                    CFBundleURLSchemes =
                    {
                        "fbXXXXXXXXXXXXXX", -- example scheme for facebook
                        "coronasdkapp", -- example second scheme
                    }
                }
            }
            --]]
		}
	},
	
	--[[
	-- Android permissions

	androidPermissions = {
  		"android.permission.INTERNET",
  	},

	]]--
}
